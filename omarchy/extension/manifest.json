{
  "manifest_version": 3,
  "name": "Rat Detective Highlights",
  "version": "1.0.0",
  "description": "Relays Rat Detective highlight markers to the local Omarchy helper. Not a product UI.",
  "key": "",
  "minimum_chrome_version": "120",
  "incognito": "not_allowed",
  "permissions": ["nativeMessaging"],
  "host_permissions": ["https://ratdetective.online/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://ratdetective.online/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
