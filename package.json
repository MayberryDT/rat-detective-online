{
  "name": "rat-detective",
  "private": true,
  "version": "0.0.0",
  "description": "A Three.js browser game served by a Cloudflare Worker with Durable Object WebSocket state.",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:worker -- --port 5173",
    "cf:types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "build": "npm run cf:types && tsc && vite build",
    "preview": "vite preview",
    "dev:worker": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run && vitest run --config vitest.client.config.ts",
    "audit": "npm audit --audit-level=high",
    "smoke:ws": "node scripts/smoke-ws.mjs",
    "smoke:browser": "node scripts/smoke-browser.mjs",
    "smoke:webgl-error": "EXPECT_WEBGL_ERROR=1 CHROME_EXTRA_ARGS='--disable-webgl --disable-3d-apis' node scripts/smoke-browser.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/node": "^26.1.0",
    "@types/three": "^0.182.0",
    "typescript": "~5.6.2",
    "vite": "^8.1.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.129.0"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "three": "^0.182.0"
  }
}
