{
  "name": "rat-detective",
  "private": true,
  "version": "0.0.0",
  "description": "A Three.js browser game served by a Cloudflare Worker with Durable Object WebSocket state.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "preview": "node scripts/preview.mjs",
    "preview:hosted": "node scripts/hosted-preview.mjs",
    "probe:network": "node scripts/probe-network.mjs",
    "dev:worker": "node scripts/preview.mjs",
    "cf:types": "wrangler types",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "build": "npm run cf:types && tsc && vite build",
    "test": "vitest run && vitest run --config vitest.client.config.ts && node --test test/scripts/*.test.mjs",
    "audit": "npm audit --audit-level=high",
    "smoke:ws": "node scripts/smoke-ws.mjs",
    "smoke:browser": "node scripts/smoke-browser.mjs",
    "smoke:webgl-error": "EXPECT_WEBGL_ERROR=1 CHROME_EXTRA_ARGS='--disable-webgl --disable-3d-apis' node scripts/smoke-browser.mjs",
    "smoke:ci": "npm run build && node scripts/with-local-worker.mjs -- npm run smoke:ws",
    "visual:build": "vite build --config vite.visual.config.ts",
    "smoke:visual": "node scripts/smoke-visual.mjs",
    "deploy": "node scripts/deploy.mjs",
    "deploy:staging": "node scripts/deploy.mjs staging",
    "deploy:production": "node scripts/deploy.mjs production",
    "smoke:gameplay": "SMOKE_GAMEPLAY=1 node scripts/smoke-browser.mjs",
    "benchmark:local": "node scripts/benchmark-local.mjs",
    "benchmark:prepare-hosted": "node scripts/prepare-hosted-capacity.mjs",
    "benchmark:hosted": "node scripts/benchmark-hosted.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/node": "^26.1.0",
    "@types/three": "^0.182.0",
    "typescript": "~5.6.2",
    "vite": "^8.1.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0",
    "ws": "8.21.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "three": "^0.182.0"
  }
}
